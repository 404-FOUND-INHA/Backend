# 운영 서버용 환경변수 예시. 서버에서 복사해 .env 로 만든 뒤 값을 채운다:
#   cp .env.prod.example .env
# 실제 값이 들어간 .env 는 절대 커밋하지 않는다.
# 주의: spring.profiles.active=dev 를 넣지 않는다 (시드 계정이 운영 DB 에 들어간다).

DB_NAME=smart_library
DB_USERNAME=capstone
# 예: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME

# 예: openssl rand -base64 24
REDIS_PASSWORD=CHANGE_ME

# JWT 서명 키 (32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# 프론트엔드 origin (쉼표 구분)
CORS_ALLOWED_ORIGINS=https://libsync.cloud,https://www.libsync.cloud

LOG_LEVEL=info

# nginx 설정: 인증서 발급 전에는 http, 발급 후에는 https
NGINX_CONF=http

# 이 파일을 복사해 .env 로 만든 뒤 값을 채우세요: cp .env.example .env
SERVER_PORT=8080
LOG_LEVEL=debug

DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_library
DB_USERNAME=capstone
DB_PASSWORD=change-me

# JWT 서명 키 (32바이트 이상). 예: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# dev 프로필: 개발용 시드 데이터(db/seed)를 함께 적용한다. 운영에서는 이 줄을 빼야 한다.
spring.profiles.active=dev
